# Скопируйте в .env и поправьте при необходимости.

# Искусственная задержка ответа API, мс. Без неё не увидеть состояние загрузки.
API_LATENCY_MS=250

# Как часто сервер меняет случайный узел и рассылает патч, мс.
LIVE_TICK_MS=3000

# false убирает панель отладки. Применяется на этапе сборки клиента.
VITE_DEBUG_PANEL=true

# Ключ Anthropic для AI-поиска. Без него поиск работает по названию.
# Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
